    "# Nettoyage avant sélection\n",
    "X_train_clean = X_train.replace([np.inf, -np.inf], np.nan).fillna(0)\n",
    "X_test_clean  = X_test.replace([np.inf, -np.inf], np.nan).fillna(0)\n",
