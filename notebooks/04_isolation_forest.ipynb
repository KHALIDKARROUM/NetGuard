   "source": [
    "contamination_values = [0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]\n",
    "sensitivity_results  = []\n",
    "\n",
    "print(f\"{'contamination':>15} | {'Precision':>10} | {'Recall':>8} | {'F1':>8} | {'ROC-AUC':>8}\")\n",
    "print('-' * 60)\n",
    "\n",
    "for c in contamination_values:\n",
    "    preds_c = scores_to_preds(scores_if, c)\n",
    "    f1      = f1_score(y_test, preds_c, zero_division=0)\n",
    "    auc     = roc_auc_score(y_test, scores_if)\n",
    "    from sklearn.metrics import precision_score, recall_score\n",
    "    p = precision_score(y_test, preds_c, zero_division=0)\n",
    "    r = recall_score(y_test, preds_c, zero_division=0)\n",
    "    sensitivity_results.append({'contamination': c, 'precision': p, 'recall': r,\n",
    "                                  'f1': f1, 'roc_auc': auc})\n",
    "    print(f'{c:>15.2f} | {p:>10.4f} | {r:>8.4f} | {f1:>8.4f} | {auc:>8.4f}')\n",
    "\n",
    "df_sens  = pd.DataFrame(sensitivity_results)\n",
    "best_c   = df_sens.loc[df_sens['f1'].idxmax(), 'contamination']\n",
    "print(f'\\nMeilleure contamination : {best_c}')"
   ]
