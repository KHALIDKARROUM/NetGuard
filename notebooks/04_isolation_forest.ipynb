    "fpr, tpr, _ = roc_curve(y_test, scores_if)\n",
    "auc_val     = roc_auc_score(y_test, scores_if)\n",
    "\n",
    "fig = go.Figure()\n",
    "fig.add_trace(go.Scatter(x=fpr, y=tpr, mode='lines',\n",
    "                          name=f'IF (AUC={auc_val:.4f})',\n",
    "                          line=dict(color='#2980b9', width=2.5),\n",
    "                          fill='tozeroy', fillcolor='rgba(41,128,185,0.08)'))\n",
    "fig.add_trace(go.Scatter(x=[0,1], y=[0,1], mode='lines', name='Aléatoire',\n",
    "                          line=dict(color='gray', dash='dash', width=1.5)))\n",
    "fig.update_layout(title='Courbe ROC — Isolation Forest',\n",
    "                   xaxis_title='FPR', yaxis_title='TPR', height=430)\n",
    "fig.show()"
   ]
