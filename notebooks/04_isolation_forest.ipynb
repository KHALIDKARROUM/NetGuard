   "source": [
    "df_scores = pd.DataFrame({'score': scores_if,\n",
    "                            'classe': np.where(y_test == 1, 'Anomalie', 'Normal')})\n",
    "threshold_val = np.percentile(scores_if, 100 * (1 - best_c))\n",
    "\n",
    "fig = px.histogram(df_scores, x='score', color='classe', barmode='overlay',\n",
    "                    nbins=80, opacity=0.75,\n",
    "                    color_discrete_map={'Normal': '#2ecc71', 'Anomalie': '#e74c3c'},\n",
    "                    title='Distribution des scores d\\'anomalie — Isolation Forest',\n",
    "                    labels={'score': 'Score [0-1]', 'count': 'Nombre'})\n",
    "fig.add_vline(x=threshold_val, line_dash='dash', line_color='#f39c12',\n",
    "              annotation_text=f'Seuil ({threshold_val:.2f})')\n",
    "fig.update_layout(height=400)\n",
    "fig.show()"
   ]
  },
