   "source": [
    "cm     = confusion_matrix(y_test, preds_final)\n",
    "cm_pct = cm.astype(float) / cm.sum() * 100\n",
    "labels = ['Normal', 'Anomalie']\n",
    "text   = [[f'{cm[i,j]:,}<br>{cm_pct[i,j]:.1f}%' for j in range(2)] for i in range(2)]\n",
    "\n",
    "fig = go.Figure(go.Heatmap(z=cm, x=[f'Prédit {l}' for l in labels],\n",
    "                             y=[f'Réel {l}' for l in labels],\n",
    "                             colorscale='Blues', text=text, texttemplate='%{text}',\n",
    "                             textfont={'size': 13}))\n",
    "fig.update_layout(title='Matrice de confusion — Isolation Forest', height=400)\n",
    "fig.show()"
   ]
  },
