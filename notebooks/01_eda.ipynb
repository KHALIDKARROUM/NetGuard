    "outlier_results = []\n",
    "\n",
    "for col in KEY_FEATURES:\n",
    "    vals = df_train[col].dropna().values\n",
    "    q1, q3 = np.percentile(vals, 25), np.percentile(vals, 75)\n",
    "    iqr    = q3 - q1\n",
    "    lower  = q1 - 1.5 * iqr\n",
    "    upper  = q3 + 1.5 * iqr\n",
    "    # np.where vectorisé — pas de boucle Python\n",
    "    n_out  = int(np.sum((vals < lower) | (vals > upper)))\n",
    "    outlier_results.append({\n",
    "        'feature':       col,\n",
    "        'Q1':            round(q1, 3),\n",
    "        'Q3':            round(q3, 3),\n",
    "        'nb_outliers':   n_out,\n",
    "        'pct_outliers':  round(n_out / len(vals) * 100, 2)\n",
    "    })\n",
    "\n",
    "df_outliers = pd.DataFrame(outlier_results).set_index('feature')\n",
    "df_outliers = df_outliers.sort_values('pct_outliers', ascending=False)\n",
    "display(df_outliers.style.background_gradient(cmap='OrRd', subset=['pct_outliers']))"
   ]
  },
