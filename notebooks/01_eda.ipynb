    "# Boxplots Normal vs Attaque pour chaque feature clé\n",
    "fig = make_subplots(rows=2, cols=3, subplot_titles=KEY_FEATURES, vertical_spacing=0.18)\n",
    "\n",
    "colors = {0: '#2ecc71', 1: '#e74c3c'}\n",
    "names  = {0: 'Normal', 1: 'Attaque'}\n",
    "\n",
    "for idx, feat in enumerate(KEY_FEATURES):\n",
    "    row = idx // 3 + 1\n",
    "    col = idx %  3 + 1\n",
    "    for lv in [0, 1]:\n",
    "        vals = df_train[df_train['label'] == lv][feat].dropna()\n",
    "        cap  = np.percentile(vals, 99)\n",
    "        fig.add_trace(\n",
    "            go.Box(y=vals[vals <= cap], name=names[lv],\n",
    "                   marker_color=colors[lv], showlegend=(idx == 0),\n",
    "                   legendgroup=names[lv], boxmean=True),\n",
    "            row=row, col=col\n",
    "        )\n",
    "\n",
    "fig.update_layout(title='Features réseau — Normal vs Attaque (cap 99e percentile)',\n",
    "                   height=580, boxmode='group')\n",
    "fig.show()"
   ]
  },
