    "# Top 20 features les plus corrélées à label\n",
    "corr = (\n",
    "    df_train[num_cols]\n",
    "    .corr()['label']\n",
    "    .drop('label')\n",
    "    .abs()\n",
    "    .sort_values(ascending=False)\n",
    "    .head(20)\n",
    ")\n",
    "\n",
    "fig = px.bar(\n",
    "    x=corr.values, y=corr.index, orientation='h',\n",
    "    color=corr.values, color_continuous_scale='Blues',\n",
    "    title='Corrélation absolue avec `label` — top 20 features',\n",
    "    labels={'x': 'Corrélation absolue', 'y': 'Feature'}\n",
    ")\n",
    "fig.update_layout(height=520, coloraxis_showscale=False)\n",
    "fig.show()"
   ]
