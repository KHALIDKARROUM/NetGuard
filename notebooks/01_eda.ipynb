    "# Features clés du trafic réseau\n",
    "KEY_FEATURES = [f for f in ['dur', 'sbytes', 'dbytes', 'rate', 'sttl', 'dttl']\n",
    "                if f in df_train.columns]\n",
    "\n",
    "# Statistiques par classe\n",
    "stats = (\n",
    "    df_train[KEY_FEATURES + ['label']]\n",
    "    .groupby('label')\n",
    "    .agg(['mean', 'median', 'std'])\n",
    "    .round(3)\n",
    ")\n",
    "stats.index = ['Normal', 'Attaque']\n",
    "display(stats)"
   ]
