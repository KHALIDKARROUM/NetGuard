   "source": [
    "if 'proto' in df_train.columns:\n",
    "    # Taux d'attaque par protocole\n",
    "    proto_stats = (\n",
    "        df_train.groupby('proto')['label']\n",
    "        .agg(['sum', 'count'])\n",
    "        .rename(columns={'sum': 'nb_attaques', 'count': 'nb_total'})\n",
    "    )\n",
    "    proto_stats['taux_attaque'] = (proto_stats['nb_attaques'] / proto_stats['nb_total'] * 100).round(2)\n",
    "    proto_stats = proto_stats.sort_values('taux_attaque', ascending=False).head(15).reset_index()\n",
    "\n",
    "    fig = px.bar(\n",
    "        proto_stats, x='proto', y='taux_attaque',\n",
    "        color='taux_attaque', color_continuous_scale='RdYlGn_r',\n",
    "        title=\"Taux d'attaque par protocole réseau (top 15)\",\n",
    "        labels={'proto': 'Protocole', 'taux_attaque': \"Taux d'attaque (%)\"}\n",
    "    )\n",
    "    fig.update_layout(height=400, coloraxis_showscale=False)\n",
    "    fig.show()"
   ]
  },
  {
