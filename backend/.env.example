# Optional for local use; required when NETGUARD_DEPLOYMENT_MODE=shared.
# Generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value in the frontend process environment; never commit the real .env.
NETGUARD_DEPLOYMENT_MODE=local
NETGUARD_API_KEY=
API_HOST=127.0.0.1
ALLOWED_HOSTS='["localhost","127.0.0.1","backend"]'
CORS_ORIGINS='["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8502","http://127.0.0.1:8502"]'
MAX_REQUEST_BYTES=1048576
REQUEST_BODY_TIMEOUT=10
REQUESTS_PER_MINUTE=120
MAX_INFLIGHT_REQUESTS=2
